{
  "name": "dilemma-dynamics",
  "description": "Exploring AI strategies, incentives and cooperation.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:public": "tsc --noEmit && vite build --mode public",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "study": "uv run gamefield-study",
    "verify:public": "node tools/check-public-repo.mjs",
    "preview:public": "vite preview --mode public --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "MIT"
}
